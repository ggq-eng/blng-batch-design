# ===================================================================
# browser-use 环境配置模板 —— 复制为 .env 后填写真实值
# ===================================================================
# 复制命令: cp .env.example .env
# ===================================================================

# ---- LLM 接入（二选一，取消对应注释）----

# [方案 A] 自有网关（ai.zlskcn.com，qwen3.6:128k）
# 注意: 必须是 OpenAI 兼容的 /v1/chat/completions 接口
OPENAI_API_KEY=sk-your-zlskcn-key
OPENAI_BASE_URL=https://ai.zlskcn.com/v1
BROWSER_USE_LLM_MODEL=qwen3.6:128k

# [方案 B] OpenAI 官方
# OPENAI_API_KEY=sk-your-openai-key
# BROWSER_USE_LLM_MODEL=gpt-4o-mini

# ---- 浏览器接入 ----
# 留空 = 使用 browser-use 自带的独立 Chromium（推荐，不影响现有浏览器）
# 如需接管已有浏览器: http://127.0.0.1:9222
BU_CDP_URL=

# ---- 目标站点 ----
TARGET_URL=https://app.blng.ai/

# ---- 运行参数 ----
# 是否显示浏览器窗口 (true=可见, false=无头)
BU_HEADLESS=false
# Agent 最大执行步数，防止无限循环烧 token
BU_MAX_STEPS=25
# 单步超时(秒)
BU_STEP_TIMEOUT=120
